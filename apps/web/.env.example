# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string. Use the TRANSACTION POOLER (port 6543)
# for serverless/Vercel — the pooler doesn't support prepared statements, so
# `pgbouncer=true` is required (lib/db.ts uses @prisma/adapter-pg).
# Find it in: Supabase dashboard > Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Random 32+ char secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# The single account allowed to log in (personal-use app, no signup flow)
AUTH_USER_EMAIL="you@example.com"

# Generate with: node scripts/hash-password.mjs "your-password"
AUTH_PASSWORD_HASH=""

# 32-byte base64 key for AES-256-GCM field encryption of PAN/Aadhaar/bank data.
# Required starting Phase 4. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""

# Vercel Blob token for Form 16 PDF storage. Required starting Phase 3.
BLOB_READ_WRITE_TOKEN=""
