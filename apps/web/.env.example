# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string. Use the TRANSACTION POOLER (port 6543)
# for serverless/Vercel — the pooler doesn't support prepared statements, so
# `pgbouncer=true` is required (lib/db.ts uses @prisma/adapter-pg).
# Find it in: Supabase dashboard > Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Random 32+ char secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# NOTE: AUTH_USER_EMAIL and AUTH_PASSWORD_HASH were REMOVED in Phase 13.
# Accounts now live in the `User` table with self-service registration at
# /register, so a single credential in the environment no longer authenticates
# anyone. Delete them from any deployment that still has them — leaving them
# set looks like a working login while doing nothing.

# 32-byte base64 key for AES-256-GCM field encryption of PAN/Aadhaar/bank data.
# Required starting Phase 4. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""

# 32-byte base64 HMAC key for the PAN blind index (lib/blindIndex.ts), which
# is what makes "one account per PAN" enforceable even though the PAN column
# itself is encrypted under a random IV and cannot be compared.
# Required starting Phase 13. MUST be different from FIELD_ENCRYPTION_KEY —
# this value is indexed and so likelier to leak, and it must not weaken the
# encrypted columns if it does. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAN_BLIND_INDEX_KEY=""

# Vercel Blob token for Form 16 PDF storage. Required starting Phase 3.
BLOB_READ_WRITE_TOKEN=""
